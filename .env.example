# Copier en .env, ne jamais versionner les vraies valeurs.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=beautyconnect
DB_USER=beautyconnect
DB_PASSWORD=beautyconnect
APP_BASE_URL=http://localhost:8080
# Inactivité : défaut dev 2h, prod 30m ; durée modifiable selon les besoins.
# SESSION_TIMEOUT=2h
# SESSION_COOKIE_NAME=BEAUTYCONNECT_SESSION_8080
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=contact@beautyconnect.local
# Pour de VRAIS mails, mettre ces lignes (avec vos identifiants) dans .env.local, jamais ici :
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=votre.adresse@gmail.com
# MAIL_PASSWORD=mot_de_passe_d_application_gmail
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=votre.adresse@gmail.com
ORS_API_KEY=
# Pour prod : SPRING_PROFILES_ACTIVE=prod, URL JDBC, mot de passe admin unique >=12 caractères.
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/BASE
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Photos : local immédiatement ; passer à cloudinary après avoir rempli les clés.
# Le dossier est créé au premier envoi. Mode : dynamic (récent) ou fixed (ancien compte).
IMAGE_STORAGE_PROVIDER=local
IMAGE_UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=beautyconnect
CLOUDINARY_FOLDER_MODE=dynamic

# Catalogue partagé et photos publiques (dev uniquement), base vide ou existante.
# Activer une fois puis désactiver ; aucune clé Cloudinary nécessaire pour afficher ces photos.
DEMO_FRANCE_ENABLED=false
